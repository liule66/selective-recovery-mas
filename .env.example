# Copy to .env (gitignored) or set as a user environment variable.
# The code also falls back to reading the key from ./api.txt (gitignored).
ANTHROPIC_API_KEY=sk-ant-...
SRMAS_MODEL=claude-haiku-5-5

# Campus gateway (set these in the environment; .env is not automatically loaded).
# OPENAI_BASE_URL=https://your-approved-campus-gateway/v1
# OPENAI_API_KEY=your-campus-key
# SRMAS_MODEL=exact-model-route-from-your-approved-key
# Verified gateway prices per million tokens (not vendor list prices):
# SRMAS_INPUT_USD_PER_M=0
# SRMAS_OUTPUT_USD_PER_M=0
